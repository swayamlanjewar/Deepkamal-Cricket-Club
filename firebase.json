{
  "firestore": {
    "rules": "firebase-backend/firestore.rules",
    "indexes": "firebase-backend/firestore.indexes.json"
  },
  "storage": {
    "rules": "firebase-backend/storage.rules"
  },
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "emulators": {
    "auth": {
      "port": 9090
    },
    "firestore": {
      "port": 8085
    },
    "storage": {
      "port": 9195
    },
    "hosting": {
      "port": 5005
    },
    "ui": {
      "enabled": true,
      "port": 4005
    },
    "singleProjectMode": true
  }
}
